{
	"extends": "@zextras/carbonio-ui-configs/rules/typescript.json",
	"compilerOptions": {
		"skipLibCheck": true,
		"jsx": "react",
		"allowJs": true,
		"checkJs": false,
		"resolveJsonModule": true
	},
	"include": [
		"**/*",
		".eslintrc.js",
		"jest.config.ts",
		"jest-setup.ts"
	],
	"exclude": ["node_modules"],
	"ts-node": {
		"transpileOnly": true
	}
}
